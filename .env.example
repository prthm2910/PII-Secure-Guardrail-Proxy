# ============================================================
# 🛡️ PII SECURE GUARDRAIL PROXY - ENVIRONMENT CONFIGURATION
# ============================================================
# IMPORTANT:
# 1. Copy this file to '.env' before running the application.
# 2. Never commit the '.env' file containing secrets to Git.
# ============================================================

# --- 🚀 App Configuration ---
PROJECT_NAME=<'PROJECT_NAME'>
DEBUG=<'DEBUG'>
HOST=<'HOST'>
PORT=<'PORT'>
APP_MODULE=<'APP_MODULE'>

# --- 🧠 Redis Configuration (Caching & State) ---
REDIS_HOST=<'REDIS_HOST'>
REDIS_PORT=<'REDIS_PORT'>
REDIS_PASSWORD=<'REDIS_PASSWORD'>
REDIS_SSL=<'REDIS_SSL'>
REDIS_DB=<'REDIS_DB'>

# --- 🛡️ PII Guardrail Settings ---
TOKEN_TTL=<'TOKEN_TTL'>
NORMALIZE_UNICODE=<'NORMALIZE_UNICODE'>
ENFORCE_STRICT_CHECKSUMS=<'ENFORCE_STRICT_CHECKSUMS'>

# --- 💾 Database Configuration (Audit & Storage) ---
DATABASE_URL=<'DATABASE_URL'>
DIRECT_DATABASE_URL=<'DIRECT_DATABASE_URL'>

# PostgreSQL connection details
POSTGRES_USER=<'POSTGRES_USER'>
POSTGRES_PASSWORD=<'POSTGRES_PASSWORD'>
POSTGRES_SERVER=<'POSTGRES_SERVER'>
POSTGRES_PORT=<'POSTGRES_PORT'>
POSTGRES_DB=<'POSTGRES_DB'>

# --- 🤖 LLM Provider Configuration ---
LLM_API_BASE_URL=<'LLM_API_BASE_URL'>
LLM_API_KEY=<'LLM_API_KEY'>
