# ============================================================
# 🛡️ PII SECURE GUARDRAIL PROXY - ENVIRONMENT CONFIGURATION
# ============================================================
# IMPORTANT: 
# 1. Copy this file to '.env' before running the application.
# 2. Never commit the '.env' file containing secrets to Git.
# ============================================================

# --- 🚀 App Configuration ---
# Name of the project, used in logs and health checks
PROJECT_NAME=PII-Secure-Guardrail-Proxy
# Set to True for development mode (detailed error reports)
DEBUG=True
# Base path for API v1 endpoints
API_V1_STR=/api/v1

# --- 🧠 Redis Configuration (Caching & State) ---
# Redis server host address
REDIS_HOST=<'REDIS_HOST'>
# Redis server port (default: 6379)
REDIS_PORT=<'REDIS_PORT'>
# Redis authentication password
REDIS_PASSWORD=<'REDIS_PASSWORD'>
# Whether to use SSL for Redis connection (True/False)
REDIS_SSL=<'REDIS_SSL'>
# Redis database index
REDIS_DB=<'REDIS_DB'>

# --- 🛡️ PII Guardrail Settings ---
# Time-to-live for tokenization mappings in seconds
TOKEN_TTL=<'TOKEN_TTL'>
# Whether to normalize unicode characters to prevent homoglyph attacks
NORMALIZE_UNICODE=<'NORMALIZE_UNICODE'>
# Whether to strictly enforce checksum validation for ID types like Aadhaar
ENFORCE_STRICT_CHECKSUMS=<'ENFORCE_STRICT_CHECKSUMS'>

# --- 💾 Database Configuration (Audit & Storage) ---
# Main PostgreSQL connection string
DATABASE_URL=<'DATABASE_URL'>
# Direct database URL for non-pooled connections
DIRECT_DATABASE_URL=<'DIRECT_DATABASE_URL'>

# PostgreSQL connection details
POSTGRES_USER=<'POSTGRES_USER'>
POSTGRES_PASSWORD=<'POSTGRES_PASSWORD'>
POSTGRES_SERVER=<'POSTGRES_SERVER'>
POSTGRES_PORT=<'POSTGRES_PORT'>
POSTGRES_DB=<'POSTGRES_DB'>

# --- 🤖 LLM Provider Configuration ---
# Base URL for the LLM API (e.g., OpenAI, Anthropic, or custom endpoints)
LLM_API_BASE_URL=<'LLM_API_BASE_URL'>
# Secret API key for authentication with the LLM provider
LLM_API_KEY=<'LLM_API_KEY'>